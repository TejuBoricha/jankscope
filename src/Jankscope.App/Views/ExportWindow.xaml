<Window x:Class="Jankscope.App.Views.ExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Export preview" Width="900" Height="700" MinWidth="640" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource ForegroundBrush}"
        FontFamily="Segoe UI" FontSize="13">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Style="{StaticResource Heading}" Text="Review before saving"/>
            <TextBlock Style="{StaticResource Muted}"
                       Text="This is exactly what will be written to the file, word for word. Nothing is saved or sent until you press Save."/>
            <CheckBox x:Name="RedactCheck" IsChecked="True" Margin="0,10,0,0" Checked="OnRedactChanged" Unchecked="OnRedactChanged"
                      Content="Remove personal information (recommended): Windows user name, PC name, network and device identifiers, command lines"
                      AutomationProperties.Name="Remove personal information"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,12,0,12" Padding="12">
            <StackPanel>
                <TextBlock x:Name="Summary" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                <TextBlock x:Name="Warning" TextWrapping="Wrap" Margin="0,6,0,0" FontWeight="SemiBold" Visibility="Collapsed"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" BorderBrush="{DynamicResource BorderLineBrush}" BorderThickness="1" CornerRadius="6" Background="{DynamicResource PanelBrush}">
            <ListBox x:Name="PreviewList" BorderThickness="0" Background="Transparent" FontFamily="Consolas" FontSize="12"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="The text that will be saved">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="8,0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                                        <ContentPresenter/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <TextBlock x:Name="SaveResult" VerticalAlignment="Center" Margin="0,0,16,0" TextWrapping="Wrap" MaxWidth="480"/>
            <Button x:Name="SaveButton" Content="Save as..." Style="{StaticResource PrimaryButton}" Click="OnSaveClicked" IsEnabled="False"/>
            <Button Content="Close" Click="OnCloseClicked" Margin="0" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
