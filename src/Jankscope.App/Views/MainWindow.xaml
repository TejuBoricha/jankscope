<Window x:Class="Jankscope.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Jankscope" Width="1120" Height="760" MinWidth="860" MinHeight="600"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource ForegroundBrush}"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- navigation -->
        <Border Grid.Column="0" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderLineBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="18,20,18,14">
                    <TextBlock Text="Jankscope" FontSize="21" FontWeight="SemiBold"/>
                    <TextBlock Style="{StaticResource Muted}" FontSize="11.5" Margin="0,4,0,0"
                               Text="Explains why a game stutters. Everything stays on this PC."/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="18,10,18,16">
                    <TextBlock x:Name="NavHotkeyStutter" Style="{StaticResource Muted}" FontSize="11.5"/>
                    <TextBlock x:Name="NavHotkeyStall" Style="{StaticResource Muted}" FontSize="11.5" Margin="0,2,0,0"/>
                    <TextBlock x:Name="NavCaptureState" FontSize="11.5" Margin="0,8,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel>
                    <RadioButton x:Name="NavCapture" Style="{StaticResource NavButton}" GroupName="Nav" IsChecked="True" Content="Capture"
                                 AutomationProperties.Name="Capture page" Checked="OnNavChecked"/>
                    <RadioButton x:Name="NavInvestigator" Style="{StaticResource NavButton}" GroupName="Nav" Content="Stutter investigator"
                                 AutomationProperties.Name="Stutter investigator page" Checked="OnNavChecked"/>
                    <RadioButton x:Name="NavSettings" Style="{StaticResource NavButton}" GroupName="Nav" Content="Settings"
                                 AutomationProperties.Name="Settings page" Checked="OnNavChecked"/>
                    <RadioButton x:Name="NavAbout" Style="{StaticResource NavButton}" GroupName="Nav" Content="About and privacy"
                                 AutomationProperties.Name="About and privacy page" Checked="OnNavChecked"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- pages -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="26,22,26,8">

                <!-- CAPTURE -->
                <ScrollViewer x:Name="PageCapture" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Heading}" Text="Capture"/>
                        <TextBlock Style="{StaticResource Muted}"
                                   Text="Choose the program to watch. Jankscope reads only the timing of frames being presented (through Windows event tracing, with the PresentMon tool); it never opens, changes or injects into the game, and it never shows anything over it."/>

                        <TextBlock Style="{StaticResource SectionTitle}" Text="1. Which program?"/>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="ScanButton" Content="Find programs that are drawing frames (5 s)" Click="OnScanClicked"
                                    AutomationProperties.Name="Find programs that are drawing frames"/>
                            <TextBlock x:Name="ScanStatus" VerticalAlignment="Center" Style="{StaticResource Muted}"/>
                        </StackPanel>
                        <ItemsControl x:Name="ProgramsList" Margin="0,8,0,0" AutomationProperties.Name="Programs drawing frames">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}" Padding="12,8" Margin="0,0,0,6">
                                        <DockPanel>
                                            <!-- No Click handler here: a handler inside a template is wired by reflection at run time, which the banned-API rule rejects. The list handles the click. -->
                                            <Button DockPanel.Dock="Right" Content="Watch this one" Tag="{Binding Application}" Margin="0"/>
                                            <TextBlock Text="{Binding FramesPerSecond, StringFormat={}{0:0.#} frames/s}" DockPanel.Dock="Right" Margin="0,0,16,0"
                                                       Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Application}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="Or type its file name:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBox x:Name="ProgramBox" Width="240" ToolTip="For example game.exe" AutomationProperties.Name="Program file name"/>
                            <Button Content="Watch" Margin="10,0,0,0" Click="OnWatchTypedClicked" Style="{StaticResource PrimaryButton}"
                                    AutomationProperties.Name="Watch the typed program"/>
                            <Button x:Name="StopButton" Content="Stop" Click="OnStopClicked" AutomationProperties.Name="Stop capturing"/>
                        </StackPanel>

                        <TextBlock Style="{StaticResource SectionTitle}" Text="2. Play, and mark what you feel"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock x:Name="StatusHeadline" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock x:Name="StatusDetail" Style="{StaticResource Muted}" Margin="0,2,0,0"/>
                                <TextBlock x:Name="LiveSummary" Margin="0,8,0,8" TextWrapping="Wrap"/>
                                <!-- The timeline is created in code: a XAML reference to a type of this assembly makes WPF generate a reflection helper that the banned-API rule rejects. -->
                                <ContentControl x:Name="LiveTimelineHost" IsTabStop="False"/>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button x:Name="MarkStutterButton" Click="OnMarkStutterClicked" AutomationProperties.Name="Mark a stutter"/>
                                    <Button x:Name="MarkStallButton" Click="OnMarkStallClicked" AutomationProperties.Name="Mark an input stall"/>
                                </StackPanel>
                                <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0"
                                           Text="Press the hotkey the moment it happens: you will hear a short tone. The key press is later than the event itself, so afterwards you choose where it really was."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- INVESTIGATOR -->
                <Grid x:Name="PageInvestigator" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="250"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <DockPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Heading}" Text="Marks"/>
                        <TextBlock x:Name="NoMarksText" DockPanel.Dock="Top" Style="{StaticResource Muted}"
                                   Text="No marks yet. While capturing, press your hotkey (or use the tray icon) when a stutter happens."/>
                        <ListBox x:Name="MarksList" SelectionChanged="OnMarkSelected" AutomationProperties.Name="Marks">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Muted}" FontSize="11.5"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>

                    <ScrollViewer Grid.Column="1" x:Name="InvestigatorDetail" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="MarkTitle" Style="{StaticResource Heading}"/>
                            <TextBlock x:Name="MarkQuality" Style="{StaticResource Muted}"/>
                            <Border Style="{StaticResource Card}" Margin="0,10,0,0" Padding="12">
                                <StackPanel>
                                    <ContentControl x:Name="InvestigatorTimelineHost" IsTabStop="False"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <Button Content="Whole window" Click="OnViewWholeClicked"/>
                                        <Button Content="Last 30 s before the key press" Click="OnViewLast30Clicked"/>
                                        <Button Content="10 s around the event" Click="OnViewAroundEventClicked"/>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0"
                                               Text="Grey bands are stretches with no frames logged. The shaded area around the dashed line is how uncertain the key-press time is. Click the timeline to place the event yourself."/>
                                </StackPanel>
                            </Border>

                            <TextBlock Style="{StaticResource SectionTitle}" Text="Where was the event?"/>
                            <TextBlock x:Name="CandidatesIntro" Style="{StaticResource Muted}"/>
                            <ListBox x:Name="CandidatesList" SelectionChanged="OnCandidateSelected" Margin="0,6,0,0" MaxHeight="190"
                                     AutomationProperties.Name="Candidate moments">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="Use the moment I pressed the key" Click="OnUseKeyPressClicked"
                                        ToolTip="The event happened before this: it takes a fraction of a second or more to react."/>
                                <Button Content="Clear my choice" Click="OnClearSelectionClicked"/>
                            </StackPanel>
                            <TextBlock x:Name="SelectionStatus" Margin="0,8,0,0" TextWrapping="Wrap" FontWeight="SemiBold"/>

                            <TextBlock Style="{StaticResource SectionTitle}" Text="Note (optional)"/>
                            <TextBox x:Name="NoteBox" MaxLength="2000" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64"
                                     LostFocus="OnNoteLostFocus" AutomationProperties.Name="Note about this mark"/>
                            <TextBlock Style="{StaticResource Muted}" FontSize="11.5" Margin="0,4,0,0"
                                       Text="Do not type names, accounts or addresses. Anything you write is redacted and shown in the preview before it is saved."/>

                            <StackPanel Orientation="Horizontal" Margin="0,16,0,16">
                                <Button x:Name="ExportButton" Content="Export (you see a preview first)..." Style="{StaticResource PrimaryButton}" Click="OnExportClicked"/>
                                <TextBlock x:Name="ExportHint" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- SETTINGS -->
                <ScrollViewer x:Name="PageSettings" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="720" HorizontalAlignment="Left">
                        <TextBlock Style="{StaticResource Heading}" Text="Settings"/>

                        <TextBlock Style="{StaticResource SectionTitle}" Text="Mark hotkeys"/>
                        <TextBlock Style="{StaticResource Muted}"
                                   Text="Each needs Ctrl or Alt. Function keys are the safest choice (letters with Ctrl+Alt are AltGr on many keyboards). On some laptops the function row needs Fn."/>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="220"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Stutter" VerticalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="StutterChordBox" Margin="0,0,0,8" AutomationProperties.Name="Stutter hotkey"/>
                            <TextBlock Grid.Row="1" Text="Input stall (keyboard only)" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="StallChordBox" AutomationProperties.Name="Input stall hotkey"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="Apply hotkeys" Style="{StaticResource PrimaryButton}" Click="OnApplyHotkeysClicked"/>
                            <Button Content="Restore defaults" Click="OnRestoreHotkeysClicked"/>
                        </StackPanel>
                        <TextBlock x:Name="HotkeyMessages" Margin="0,8,0,0" TextWrapping="Wrap"/>

                        <TextBlock Style="{StaticResource SectionTitle}" Text="Recording window"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Before the mark (30 to 600 s)" VerticalAlignment="Center" Width="210"/>
                            <TextBox x:Name="PreRollBox" Width="80" AutomationProperties.Name="Seconds recorded before the mark"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="After the mark (0 to 300 s)" VerticalAlignment="Center" Width="210"/>
                            <TextBox x:Name="PostRollBox" Width="80" AutomationProperties.Name="Seconds recorded after the mark"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0" Text="Takes effect the next time Jankscope starts."/>

                        <TextBlock Style="{StaticResource SectionTitle}" Text="Look and sound"/>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="ThemeSystem" GroupName="Theme" Content="Follow Windows" Checked="OnThemeChanged"/>
                            <RadioButton x:Name="ThemeLight" GroupName="Theme" Content="Light" Checked="OnThemeChanged"/>
                            <RadioButton x:Name="ThemeDark" GroupName="Theme" Content="Dark" Checked="OnThemeChanged"/>
                        </StackPanel>
                        <CheckBox x:Name="SoundCheck" Margin="0,10,0,0" Content="Play a tone when a mark is recorded" Checked="OnSoundChanged" Unchecked="OnSoundChanged"/>

                        <Button Content="Show the welcome screen again" Margin="0,22,0,0" HorizontalAlignment="Left" Click="OnShowWelcomeClicked"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- ABOUT -->
                <ScrollViewer x:Name="PageAbout" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="760" HorizontalAlignment="Left">
                        <TextBlock Style="{StaticResource Heading}" Text="About and privacy"/>
                        <TextBlock x:Name="AboutVersion" Style="{StaticResource Muted}"/>

                        <TextBlock Style="{StaticResource SectionTitle}" Text="What this program does and does not do"/>
                        <TextBlock TextWrapping="Wrap" x:Name="AboutPrivacy"/>

                        <TextBlock Style="{StaticResource SectionTitle}" Text="Anti-cheat"/>
                        <TextBlock TextWrapping="Wrap" x:Name="AboutAntiCheat"/>

                        <TextBlock Style="{StaticResource SectionTitle}" Text="This PC (read-only checks)"/>
                        <TextBlock x:Name="AboutEnvironment" TextWrapping="Wrap" Style="{StaticResource Muted}"/>

                        <TextBlock Style="{StaticResource SectionTitle}" Text="Compatibility report"/>
                        <TextBlock TextWrapping="Wrap" Style="{StaticResource Muted}"
                                   Text="Exports a full diagnostic summary of this PC's hardware, drivers, capabilities, and probe health. Completely redacted and previewable before saving."/>
                        <Button x:Name="ExportCompatibilityButton" Content="Export compatibility report (you see a preview first)..." Margin="0,8,0,0" HorizontalAlignment="Left"
                                Click="OnExportCompatibilityClicked" AutomationProperties.Name="Export compatibility report"/>

                        <StackPanel x:Name="SponsorPanel" Visibility="Collapsed" Margin="0,14,0,0">
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Support development"/>
                            <TextBlock x:Name="SponsorText" TextWrapping="Wrap" Style="{StaticResource Muted}"
                                       Text="Jankscope is free and open-source with no ads and no tracking. Voluntary support helps fund continued development."/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button x:Name="SponsorButton" Content="GitHub Sponsors" Margin="0,0,10,0" Click="OnSponsorClicked" Visibility="Collapsed" AutomationProperties.Name="Open GitHub Sponsors page"/>
                                <Button x:Name="StoreButton" Content="Microsoft Store edition" Click="OnStoreClicked" Visibility="Collapsed" AutomationProperties.Name="Open Microsoft Store listing"/>
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Style="{StaticResource SectionTitle}" Text="License"/>
                        <TextBlock TextWrapping="Wrap" Text="Jankscope is free, open-source software under the MIT license, with no advertising and no telemetry."/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- notices -->
            <Border Grid.Row="1" x:Name="NoticeBar" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderLineBrush}"
                    BorderThickness="0,1,0,0" Padding="26,8" Visibility="Collapsed">
                <TextBlock x:Name="NoticeText" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
            </Border>
        </Grid>
    </Grid>
</Window>
