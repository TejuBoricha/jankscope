<Window x:Class="Jankscope.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Jankscope Studio - Frame Pacing &amp; Stutter Forensics" Width="1440" Height="900" MinWidth="1020" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource ForegroundBrush}"
        FontFamily="Segoe UI" FontSize="12.5">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="228"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- MACHINED INSTRUMENT CHASSIS RAIL -->
        <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderLineBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="10,14">
                <!-- Brand Emblem & Telemetry Identity -->
                <StackPanel DockPanel.Dock="Top" Margin="8,0,8,14">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="8" Height="16" CornerRadius="2" Background="{DynamicResource CyanAccentBrush}" Margin="0,0,8,0"/>
                        <TextBlock Text="JANK//SCOPE" FontFamily="Consolas" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Border Style="{StaticResource BadgeBorder}" Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentBrush}" Margin="8,0,0,0" Padding="5,1">
                            <TextBlock Text="PRO" FontFamily="Consolas" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource CyanAccentBrush}"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Style="{StaticResource Muted}" FontFamily="Consolas" FontSize="10" Margin="0,4,0,0" Text="PRECISION FRAME &amp; INPUT FORENSICS"/>
                </StackPanel>

                <!-- Bottom Global Hotkey & Hardware Coexistence Pod -->
                <Border DockPanel.Dock="Bottom" Style="{StaticResource KpiCard}" Margin="4,8,4,0" Padding="10,9">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Border Width="6" Height="6" CornerRadius="3" Background="{DynamicResource OkBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Style="{StaticResource Overline}" Text="GLOBAL MARK HOTKEYS"/>
                        </StackPanel>
                        <TextBlock x:Name="NavHotkeyStutter" Style="{StaticResource MonoValue}" FontSize="11.5" Margin="0,2,0,2"/>
                        <TextBlock x:Name="NavHotkeyInput" Style="{StaticResource MonoValue}" FontSize="11.5" Margin="0,0,0,2"/>
                        <TextBlock x:Name="NavHotkeyProblem" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" FontSize="11" Visibility="Collapsed"/>
                        <Border Height="1" Background="{DynamicResource BorderLineBrush}" Margin="0,6"/>
                        <TextBlock Style="{StaticResource Muted}" FontFamily="Consolas" FontSize="9.5" Text="HC-1..13 // ZERO HOOKS // OFFLINE"/>
                    </StackPanel>
                </Border>

                <!-- Studio Workspace Matrix Rail -->
                <StackPanel>
                    <TextBlock Style="{StaticResource Overline}" Margin="10,0,0,5" Text="TELEMETRY DECKS"/>
                    <RadioButton x:Name="NavCapture" Style="{StaticResource NavButton}" GroupName="Nav" IsChecked="True" Checked="OnNavChanged"
                                 Content="01 // Live Capture Scope" AutomationProperties.Name="Live Capture and Scope"/>
                    <RadioButton x:Name="NavInvestigator" Style="{StaticResource NavButton}" GroupName="Nav" Checked="OnNavChanged"
                                 Content="02 // Forensic Workbench" AutomationProperties.Name="Stutter investigator"/>
                    <RadioButton x:Name="NavRadar" Style="{StaticResource NavButton}" GroupName="Nav" Checked="OnNavChanged"
                                 Content="03 // Capability Radar" AutomationProperties.Name="System Capability Radar"/>
                    <RadioButton x:Name="NavLab" Style="{StaticResource NavButton}" GroupName="Nav" Checked="OnNavChanged"
                                 Content="04 // Input Polling Lab" AutomationProperties.Name="Input and Polling Lab"/>

                    <TextBlock Style="{StaticResource Overline}" Margin="10,16,0,5" Text="SYSTEM &amp; TRUST"/>
                    <RadioButton x:Name="NavSettings" Style="{StaticResource NavButton}" GroupName="Nav" Checked="OnNavChanged"
                                 Content="05 // Studio Configuration" AutomationProperties.Name="Settings"/>
                    <RadioButton x:Name="NavAbout" Style="{StaticResource NavButton}" GroupName="Nav" Checked="OnNavChanged"
                                 Content="06 // Spec &amp; Privacy Proof" AutomationProperties.Name="About and privacy"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- MAIN INSTRUMENT CONSOLE VIEWPORT -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Persistent Top Studio Transport & Workbench Header -->
            <Border Grid.Row="0" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderLineBrush}" BorderThickness="0,0,0,1" Padding="18,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource BadgeBorder}" Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentBrush}" Margin="0,0,10,0" VerticalAlignment="Center">
                        <TextBlock Text="TELEMETRY PIPELINE" FontFamily="Consolas" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource CyanAccentBrush}"/>
                    </Border>

                    <TextBlock Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" FontFamily="Consolas" FontSize="11.5">
                        <Run Foreground="{DynamicResource CyanAccentBrush}" FontWeight="Bold" Text="[STEP 1]"/>
                        <Run Text=" Target 3D App or Simulator  "/>
                        <Run Foreground="{DynamicResource WarningBrush}" FontWeight="Bold" Text="[STEP 2]"/>
                        <Run Text=" Press Ctrl+Alt+F9 on Hitch  "/>
                        <Run Foreground="{DynamicResource OkBrush}" FontWeight="Bold" Text="[STEP 3]"/>
                        <Run Text=" Inspect 31-Frame Waterfall &amp; Export"/>
                    </TextBlock>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="ProvenanceBadge" Style="{StaticResource BadgeBorder}" Margin="0,0,10,0" Visibility="Collapsed" VerticalAlignment="Center">
                            <TextBlock x:Name="ProvenanceBadgeText" FontFamily="Consolas" FontSize="10.5" FontWeight="Bold"/>
                        </Border>
                        <Button x:Name="SimulateDemoButton" Style="{StaticResource SimButton}" Click="OnSimulateDemoClicked" Margin="0"
                                Content="Simulate 120 FPS Stutter Trace"
                                ToolTip="Streams a realistic 120 FPS session with injected shader-compile and asset-streaming hitches and records a sample mark so you can inspect the Forensic Workbench immediately."/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ========================================================================= -->
            <!-- WORKSPACE 01: ZERO-SCROLL LIVE CAPTURE & MULTI-SCOPE TELEMETRY CONSOLE     -->
            <!-- ========================================================================= -->
            <Grid x:Name="PageCapture" Grid.Row="1" Margin="16,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="1.18*"/>
                    <RowDefinition Height="0.95*"/>
                </Grid.RowDefinitions>

                <!-- Row 0: Unified Hardware Transport & Target Acquisition Strip -->
                <Border Grid.Row="0" Style="{StaticResource HeroCard}" Margin="0,0,0,10" Padding="14,9">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.15*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Live Status Readout -->
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                                <StackPanel Orientation="Horizontal">
                                    <Border x:Name="CaptureStateDot" Width="9" Height="9" CornerRadius="4.5" Background="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock x:Name="CaptureHeadline" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/>
                                    <TextBlock x:Name="MarkFeedback" Margin="14,0,0,0" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource CyanAccentBrush}" AutomationProperties.LiveSetting="Polite"/>
                                </StackPanel>
                                <TextBlock x:Name="CaptureDetail" Style="{StaticResource Muted}" FontSize="11.5" Margin="17,2,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <!-- Target Executable Input & Transport Controls -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                <TextBlock Text="TARGET:" Style="{StaticResource Overline}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox x:Name="ProgramBox" Width="142" Margin="0,0,6,0" VerticalAlignment="Center"
                                         AutomationProperties.Name="Executable file name, for example game.exe"
                                         ToolTip="Plain executable name only, e.g. eldenring.exe or cs2.exe (no folder path)."/>
                                <Button x:Name="StartButton" Content="Start" Style="{StaticResource PrimaryButton}" Click="OnStartClicked"/>
                                <Button x:Name="StopButton" Content="Stop" Click="OnStopClicked" IsEnabled="False"/>
                                <Button x:Name="ScanButton" Content="Scan 3D" Click="OnScanClicked" Margin="0"/>
                            </StackPanel>

                            <!-- Instant Incident Triggers -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="1" Height="24" Background="{DynamicResource BorderLineBrush}" Margin="4,0,10,0"/>
                                <Button x:Name="MarkStutterButton" Content="Mark Stutter" Style="{StaticResource PrimaryButton}" Click="OnMarkStutterClicked"/>
                                <Button x:Name="MarkInputButton" Content="Mark Input Stall" Click="OnMarkInputClicked" Margin="0"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock x:Name="ScanStatus" Style="{StaticResource Muted}" FontSize="11.5" Margin="0,6,0,0" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite"/>
                        <ListBox x:Name="ScanResultsList" MaxHeight="85" Margin="0,4,0,0" Visibility="Collapsed" SelectionChanged="OnScanResultPicked"
                                 AutomationProperties.Name="Programs currently presenting frames"/>
                    </StackPanel>
                </Border>

                <!-- Row 1: 5-Channel Digital Multimeter Telemetry Strip -->
                <UniformGrid Grid.Row="1" Columns="5" Margin="0,0,0,10">
                    <Border Style="{StaticResource KpiCard}" Margin="0,0,8,0">
                        <StackPanel>
                            <DockPanel>
                                <Border Width="3" Height="11" CornerRadius="1.5" Background="{DynamicResource CyanAccentBrush}" Margin="0,0,6,0"/>
                                <TextBlock Style="{StaticResource Overline}" Text="CH1 // FRAME RATE (5S)"/>
                            </DockPanel>
                            <TextBlock x:Name="KpiAvgFps" Style="{StaticResource KpiValue}" Text="-- FPS" Margin="0,3,0,1"/>
                            <TextBlock x:Name="KpiAvgFpsSub" Style="{StaticResource Muted}" FontFamily="Consolas" FontSize="10.5" Text="Median: -- ms"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource KpiCard}" Margin="0,0,8,0">
                        <StackPanel>
                            <DockPanel>
                                <Border Width="3" Height="11" CornerRadius="1.5" Background="{DynamicResource AccentBrush}" Margin="0,0,6,0"/>
                                <TextBlock Style="{StaticResource Overline}" Text="CH2 // 99TH TAIL (30S)"/>
                            </DockPanel>
                            <TextBlock x:Name="KpiP99Ms" Style="{StaticResource KpiValue}" Text="-- ms" Margin="0,3,0,1"/>
                            <TextBlock x:Name="KpiP99Sub" Style="{StaticResource Muted}" FontFamily="Consolas" FontSize="10.5" Text="1% low: -- FPS"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource KpiCard}" Margin="0,0,8,0">
                        <StackPanel>
                            <DockPanel>
                                <Border Width="3" Height="11" CornerRadius="1.5" Background="{DynamicResource OkBrush}" Margin="0,0,6,0"/>
                                <TextBlock Style="{StaticResource Overline}" Text="CH3 // PACING INDEX"/>
                            </DockPanel>
                            <TextBlock x:Name="KpiConsistency" Style="{StaticResource KpiValue}" Text="-- / 100" Margin="0,3,0,1"/>
                            <TextBlock x:Name="KpiConsistencySub" Style="{StaticResource Muted}" FontFamily="Consolas" FontSize="10.5" Text="Awaiting stream"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource KpiCard}" Margin="0,0,8,0">
                        <StackPanel>
                            <DockPanel>
                                <Border Width="3" Height="11" CornerRadius="1.5" Background="{DynamicResource WarningBrush}" Margin="0,0,6,0"/>
                                <TextBlock Style="{StaticResource Overline}" Text="CH4 // STUTTER EVENTS"/>
                            </DockPanel>
                            <TextBlock x:Name="KpiStutterCount" Style="{StaticResource KpiValue}" Text="0" Margin="0,3,0,1"/>
                            <TextBlock x:Name="KpiStutterSub" Style="{StaticResource Muted}" FontFamily="Consolas" FontSize="10.5" Text=">2.5x P50 &amp; +4 ms"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource KpiCard}">
                        <StackPanel>
                            <DockPanel>
                                <Border Width="3" Height="11" CornerRadius="1.5" Background="{DynamicResource PurpleAccentBrush}" Margin="0,0,6,0"/>
                                <TextBlock Style="{StaticResource Overline}" Text="CH5 // RING INTEGRITY"/>
                            </DockPanel>
                            <TextBlock x:Name="KpiIntegrity" Style="{StaticResource KpiValue}" Text="0 frames" Margin="0,3,0,1"/>
                            <TextBlock x:Name="KpiIntegritySub" Style="{StaticResource Muted}" FontFamily="Consolas" FontSize="10.5" Text="0 dropped | Ready"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Row 2: Full-Width Digital Phosphor Oscilloscope -->
                <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="0,0,0,6">
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Muted}" FontFamily="Consolas" FontSize="10.5" VerticalAlignment="Center"
                                       Text="BUDGET HAIRLINES: 8.3 ms (120 Hz) // 16.7 ms (60 Hz) // 33.3 ms (30 Hz) // HOVER FOR CURSOR LOUPE"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="3" Height="12" CornerRadius="1.5" Background="{DynamicResource CyanAccentBrush}" Margin="0,0,7,0"/>
                                <TextBlock Style="{StaticResource CardTitle}" Text="01 // DIGITAL PHOSPHOR FRAME-TIME OSCILLOSCOPE (30S ROLLING WINDOW)"/>
                            </StackPanel>
                        </DockPanel>
                        <ContentControl x:Name="LiveTimelineHost" Grid.Row="1" Focusable="False"/>
                        <TextBlock x:Name="LiveNumbers" Grid.Row="2" Style="{StaticResource MonoValue}" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
                    </Grid>
                </Border>

                <!-- Row 3: Dual-Bay Micro-Anatomy Waterfall & Radial Smoothness Gauge -->
                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.32*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Bay Left: 31-Frame Spike Micro-Anatomy & Poincare Jitter Radar -->
                    <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,10,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0" Margin="0,0,0,6">
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Muted}" FontFamily="Consolas" FontSize="10" VerticalAlignment="Center"
                                           Text="AUTO-LOCKS ON PEAK SPIKE IN WINDOW"/>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="3" Height="12" CornerRadius="1.5" Background="{DynamicResource WarningBrush}" Margin="0,0,7,0"/>
                                    <TextBlock Style="{StaticResource CardTitle}" Text="02 // SPIKE MICRO-ANATOMY &amp; POINCARE PHASE-SPACE RADAR"/>
                                </StackPanel>
                            </DockPanel>
                            <ContentControl x:Name="LiveAnatomyHost" Grid.Row="1" Focusable="False"/>
                        </Grid>
                    </Border>

                    <!-- Bay Right: Radial Smoothness Gauge & 5-Tier Latency Histogram -->
                    <Border Grid.Column="1" Style="{StaticResource Card}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0" Margin="0,0,0,6">
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Muted}" FontFamily="Consolas" FontSize="10" VerticalAlignment="Center"
                                           Text="240+ HZ TO SUB-30 HZ TIERS"/>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="3" Height="12" CornerRadius="1.5" Background="{DynamicResource OkBrush}" Margin="0,0,7,0"/>
                                    <TextBlock Style="{StaticResource CardTitle}" Text="03 // PACING CONSISTENCY GAUGE &amp; TIER HISTOGRAM"/>
                                </StackPanel>
                            </DockPanel>
                            <ContentControl x:Name="LiveDistributionHost" Grid.Row="1" Focusable="False"/>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- ========================================================================= -->
            <!-- WORKSPACE 02: ZERO-SCROLL FORENSIC INCIDENT WORKBENCH                     -->
            <!-- ========================================================================= -->
            <Grid x:Name="PageInvestigator" Grid.Row="1" Visibility="Collapsed" Margin="16,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="236"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Column: Incident Tape & Quick Demo Generator -->
                <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,12,0">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                <Border Width="3" Height="12" CornerRadius="1.5" Background="{DynamicResource CyanAccentBrush}" Margin="0,0,7,0"/>
                                <TextBlock Style="{StaticResource CardTitle}" Text="INCIDENT TAPE // MARKS"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource Muted}" FontSize="11"
                                       Text="Frozen pre-roll &amp; post-roll capture windows."/>
                        </StackPanel>

                        <Border DockPanel.Dock="Bottom" Style="{StaticResource KpiCard}" Margin="0,8,0,0" Padding="10,8">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Overline}" Text="SYNTHETIC BENCHMARK"/>
                                <TextBlock Style="{StaticResource Muted}" FontSize="11" Margin="0,3,0,6"
                                           Text="Generate an instant 120 FPS trace with a marked shader hitch:"/>
                                <Button Content="Generate Simulated Mark" Style="{StaticResource SimButton}" Click="OnSimulateDemoClicked" Margin="0"/>
                            </StackPanel>
                        </Border>

                        <ListBox x:Name="MarksList" SelectionChanged="OnMarkSelected" AutomationProperties.Name="Marks in this session">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,2">
                                        <TextBlock Text="{Binding Title}" FontFamily="Consolas" FontWeight="Bold" FontSize="11.5"/>
                                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Muted}" FontSize="10.5" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <!-- Right Column: Zero-Scroll Full-Viewport Forensic Cockpit -->
                <Grid Grid.Column="1">
                    <Border x:Name="NoMarkHint" Style="{StaticResource Card}" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="NO INCIDENT MARK SELECTED"/>
                            <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0"
                                       Text="Start capturing (or click 'Simulate 120 FPS Stutter Trace' in the top right) and press the stutter hotkey to inspect a frozen incident window here."/>
                        </StackPanel>
                    </Border>

                    <Grid x:Name="MarkDetailPanel" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="1.08*"/>
                            <RowDefinition Height="1*"/>
                        </Grid.RowDefinitions>

                        <!-- Row 0: Incident Command Bar & Redacted Bundle Export -->
                        <Border Grid.Row="0" Style="{StaticResource HeroCard}" Margin="0,0,0,8" Padding="14,8">
                            <DockPanel>
                                <Button x:Name="ExportButton" DockPanel.Dock="Right" Content="Preview &amp; Export Redacted Bundle..."
                                        Style="{StaticResource PrimaryButton}" Click="OnExportClicked" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                <StackPanel>
                                    <TextBlock x:Name="MarkSummaryLine" FontFamily="Consolas" FontSize="12.5" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="SelectionStatus" FontFamily="Consolas" FontSize="11.5" Foreground="{DynamicResource CyanAccentBrush}" FontWeight="SemiBold" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- Row 1: 5-Channel Incident Window Readout Strip -->
                        <UniformGrid Grid.Row="1" Columns="5" Margin="0,0,0,8">
                            <Border Style="{StaticResource KpiCard}" Margin="0,0,8,0" Padding="10,6">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Overline}" Text="WINDOW AVG FPS"/>
                                    <TextBlock x:Name="InvAvgFps" Style="{StaticResource KpiValue}" FontSize="18" Text="--" Margin="0,2,0,0"/>
                                    <TextBlock x:Name="InvSampleCount" Style="{StaticResource Muted}" FontFamily="Consolas" FontSize="10" Text="-- samples"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource KpiCard}" Margin="0,0,8,0" Padding="10,6">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Overline}" Text="MEDIAN (P50)"/>
                                    <TextBlock x:Name="InvMedianMs" Style="{StaticResource KpiValue}" FontSize="18" Text="-- ms" Margin="0,2,0,0"/>
                                    <TextBlock Style="{StaticResource Muted}" FontFamily="Consolas" FontSize="10" Text="Baseline cadence"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource KpiCard}" Margin="0,0,8,0" Padding="10,6">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Overline}" Text="99TH PERCENTILE"/>
                                    <TextBlock x:Name="InvP99Ms" Style="{StaticResource KpiValue}" FontSize="18" Text="-- ms" Margin="0,2,0,0"/>
                                    <TextBlock Style="{StaticResource Muted}" FontFamily="Consolas" FontSize="10" Text="1% low frame time"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource KpiCard}" Margin="0,0,8,0" Padding="10,6">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Overline}" Text="99.9TH TAIL PEAK"/>
                                    <TextBlock x:Name="InvP999Ms" Style="{StaticResource KpiValue}" FontSize="18" Foreground="{DynamicResource WarningBrush}" Text="-- ms" Margin="0,2,0,0"/>
                                    <TextBlock Style="{StaticResource Muted}" FontFamily="Consolas" FontSize="10" Text="0.1% worst excursion"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource KpiCard}" Padding="10,6">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Overline}" Text="STUTTER EVENTS"/>
                                    <TextBlock x:Name="InvStutters" Style="{StaticResource KpiValue}" FontSize="18" Text="--" Margin="0,2,0,0"/>
                                    <TextBlock x:Name="InvClusters" Style="{StaticResource Muted}" FontFamily="Consolas" FontSize="10" Text="-- clusters"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- Row 2: Split Dual-Scope Forensic Deck (Macro Incident Timeline + 31-Frame Spike Micro-Waterfall) -->
                        <Grid Grid.Row="2" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.25*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Scope 01: Macro Incident Timeline & Reaction-Time Uncertainty Band -->
                            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <DockPanel Grid.Row="0" Margin="0,0,0,5">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                            <RadioButton x:Name="ZoomAll" Style="{StaticResource PillRadio}" GroupName="Zoom" Content="Full" Checked="OnZoomChanged"/>
                                            <RadioButton x:Name="Zoom30" Style="{StaticResource PillRadio}" GroupName="Zoom" Content="30 s" IsChecked="True" Checked="OnZoomChanged"/>
                                            <RadioButton x:Name="Zoom10" Style="{StaticResource PillRadio}" GroupName="Zoom" Content="10 s" Checked="OnZoomChanged" Margin="0"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="3" Height="12" CornerRadius="1.5" Background="{DynamicResource CyanAccentBrush}" Margin="0,0,7,0"/>
                                            <TextBlock Style="{StaticResource CardTitle}" Text="01 // INCIDENT TIMELINE &amp; ANCHOR SCRUBBER"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <ContentControl x:Name="InvestigatorTimelineHost" Grid.Row="1" Focusable="False"/>
                                    <TextBlock Grid.Row="2" Style="{StaticResource Muted}" FontFamily="Consolas" FontSize="10" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"
                                               Text="AMBER DASH = KEY PRESS // NUMBERED BADGES = CANDIDATE SPIKES // SOLID GREEN = CHOSEN ANCHOR (CLICK CHART TO SET)"/>
                                </Grid>
                            </Border>

                            <!-- Scope 02: 31-Frame Spike Micro-Waterfall & Poincare Phase Radar -->
                            <Border Grid.Column="1" Style="{StaticResource Card}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <DockPanel Grid.Row="0" Margin="0,0,0,5">
                                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Muted}" FontFamily="Consolas" FontSize="10" VerticalAlignment="Center"
                                                   Text="CENTERED ON ANCHOR"/>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="3" Height="12" CornerRadius="1.5" Background="{DynamicResource WarningBrush}" Margin="0,0,7,0"/>
                                            <TextBlock Style="{StaticResource CardTitle}" Text="02 // ANCHOR SPIKE 31-FRAME ANATOMY"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <ContentControl x:Name="InvestigatorAnatomyHost" Grid.Row="1" Focusable="False"/>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Row 3: 3-Column Causal Decision, Evidence-Graded Hypotheses & Smoothness Matrix -->
                        <Grid Grid.Row="3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0.95*"/>
                                <ColumnDefinition Width="1.35*"/>
                                <ColumnDefinition Width="0.95*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Col 0: Candidate Spike Anchors & Contextual Note -->
                            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Margin="0,0,0,5">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="3" Height="12" CornerRadius="1.5" Background="{DynamicResource OkBrush}" Margin="0,0,7,0"/>
                                            <TextBlock Style="{StaticResource CardTitle}" Text="03 // CANDIDATE SPIKE ANCHORS"/>
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource Muted}" FontSize="10.5" Margin="0,2,0,0"
                                                   Text="Pick the spike that caused your reaction (150-400 ms before key press):"/>
                                    </StackPanel>

                                    <ListBox x:Name="CandidatesList" Grid.Row="1" SelectionChanged="OnCandidatePicked"
                                             AutomationProperties.Name="Candidate moments before the key press">
