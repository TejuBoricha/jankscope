                            </Grid>

                            <CheckBox x:Name="SoundCheck" Margin="0,12,0,8" Content="Play an audible confirmation tone when a mark hotkey is pressed (zero in-game visual overlay)"/>
                            <WrapPanel>
                                <Button Content="Test Stutter Tone (Rising)" Click="OnTestStutterToneClicked"/>
                                <Button Content="Test Input-Freeze Tone (Falling)" Click="OnTestInputToneClicked"/>
                                <Button Content="Test Not-Capturing Tone (Low)" Click="OnTestWarnToneClicked" Margin="0"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="03 // INSTRUMENT CHASSIS THEME"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <RadioButton x:Name="ThemeSystem" Style="{StaticResource PillRadio}" GroupName="Theme" Content="Follow Windows"/>
                                <RadioButton x:Name="ThemeDark" Style="{StaticResource PillRadio}" GroupName="Theme" Content="Obsidian Phosphor Dark (Recommended)"/>
                                <RadioButton x:Name="ThemeLight" Style="{StaticResource PillRadio}" GroupName="Theme" Content="Daylight Laboratory" Margin="0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Button x:Name="SaveSettingsButton" Content="Apply &amp; Save Configuration" Style="{StaticResource PrimaryButton}" Click="OnSaveSettingsClicked"/>
                        <Button Content="Reset Defaults" Click="OnResetSettingsClicked"/>
                        <TextBlock x:Name="SettingsResult" VerticalAlignment="Center" Margin="8,0,0,0" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- ========================================================================= -->
            <!-- WORKSPACE 06: SPEC, PRIVACY PROOF & COMPATIBILITY EXPORT                  -->
            <!-- ========================================================================= -->
            <Grid x:Name="PageAbout" Grid.Row="1" Visibility="Collapsed" Margin="16,12">
                <StackPanel>
                    <Border Style="{StaticResource HeroCard}" Margin="0,0,0,12">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Show Welcome &amp; Privacy Notice" Click="OnShowWelcomeClicked" VerticalAlignment="Center" Margin="16,0,0,0"/>
                            <StackPanel>
                                <TextBlock Style="{StaticResource Heading}" Text="Architecture Specification &amp; Privacy Guarantees"/>
                                <TextBlock x:Name="VersionLine" Style="{StaticResource Muted}" FontFamily="Consolas"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <UniformGrid Columns="2" Margin="0,0,0,12">
                        <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Overline}" Foreground="{DynamicResource OkBrush}" Text="PERMITTED INTERFACES"/>
                                <TextBlock Style="{StaticResource CardTitle}" Margin="0,4,0,6" Text="Documented User-Mode Windows Telemetry Only"/>
                                <TextBlock Style="{StaticResource Muted}" FontSize="11.5"
                                           Text="1. PresentMon ETW swap-chain events for the chosen target application while capturing.&#x0a;2. Your two registered hotkey chords via RegisterHotKey.&#x0a;3. Read-only system capability probes (DXGI, CPU topology, display refresh, anti-cheat presence).&#x0a;4. Local Windows username and PC hostname solely to strip them from exported files."/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Overline}" Foreground="{DynamicResource CyanAccentBrush}" Text="COMPILE-TIME HARD CONSTRAINTS (HC-1 .. HC-13)"/>
                                <TextBlock Style="{StaticResource CardTitle}" Margin="0,4,0,6" Text="Static Banned-Symbol Safety Proofs"/>
                                <TextBlock Style="{StaticResource Muted}" FontSize="11.5"
                                           Text="1. Zero DLL injection, API hooks, or foreign process memory reads.&#x0a;2. Zero kernel drivers or undocumented syscalls.&#x0a;3. Zero in-game overlays or D3D/Vulkan swap-chain hooks.&#x0a;4. Zero outbound network connections (System.Net.* is banned at compile time)."/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="SYSTEM CHECK SUMMARY &amp; COMPATIBILITY EXPORT"/>
                            <TextBlock x:Name="CapabilitySummary" Style="{StaticResource MonoValue}" FontSize="11.5" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,10"/>
                            <TextBlock x:Name="ProblemsBox" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" Margin="0,0,0,10" Visibility="Collapsed"/>
                            <WrapPanel>
                                <Button x:Name="ExportCompatibilityButton" Content="Export Redacted Compatibility Report..." Style="{StaticResource PrimaryButton}" Click="OnExportCompatibilityClicked"/>
                                <Button Content="Open System Capability Radar" Click="OnJumpToRadarClicked" Margin="0"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="OPEN-SOURCE COMMUNITY &amp; SUPPORT"/>
                            <TextBlock Style="{StaticResource Muted}" FontSize="11.5" Margin="0,4,0,10"
                                       Text="Jankscope is MIT-licensed open-source software with zero telemetry, zero ads, and zero feature gates. The static links below open only in your default browser when clicked."/>
                            <WrapPanel>
                                <Button x:Name="OpenSponsorButton" Content="Sponsor on GitHub" Click="OnOpenSponsorClicked"/>
                                <Button x:Name="OpenStoreButton" Content="Microsoft Store" Click="OnOpenStoreClicked" Margin="0"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
