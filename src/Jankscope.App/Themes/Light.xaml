<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Signal bench, daylight: warm paper instrument surfaces. The live colour is a deeper olive
         so it stays readable on white; amber keeps marks; indigo keeps simulated data. -->

    <!-- Surfaces: warm paper, layered from the window back to raised cards -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F4F2EA"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="#EAE7DC"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#FBFAF5"/>
    <SolidColorBrush x:Key="PanelRaisedBrush" Color="#F1EEE4"/>
    <SolidColorBrush x:Key="PanelInsetBrush" Color="#E7E3D6"/>
    <SolidColorBrush x:Key="CardHeaderBrush" Color="#F6F4EC"/>

    <LinearGradientBrush x:Key="HeroBannerBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#EEF5D8" Offset="0.0"/>
        <GradientStop Color="#F4F2EA" Offset="0.6"/>
        <GradientStop Color="#EFEBDD" Offset="1.0"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="KpiCardBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFF" Offset="0.0"/>
        <GradientStop Color="#F8F7F1" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- Text and borders -->
    <SolidColorBrush x:Key="ForegroundBrush" Color="#171A12"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#5A604C"/>
    <SolidColorBrush x:Key="SubtleTextBrush" Color="#7C8270"/>
    <SolidColorBrush x:Key="BorderLineBrush" Color="#D3CFBF"/>
    <SolidColorBrush x:Key="BorderHighlightBrush" Color="#A9A48E"/>

    <!-- Accent: deep olive is the one live/primary colour. Purple keys hold the dark amber mark colour. -->
    <SolidColorBrush x:Key="AccentBrush" Color="#4F7A00"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#E4EFC6"/>
    <SolidColorBrush x:Key="AccentTextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CyanAccentBrush" Color="#2F6F8A"/>
    <SolidColorBrush x:Key="PurpleAccentBrush" Color="#9A5B00"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#E7E4D6"/>
    <SolidColorBrush x:Key="SelectedBrush" Color="#DCE8B8"/>

    <!-- Status and evidence -->
    <SolidColorBrush x:Key="OkBrush" Color="#2F6B1F"/>
    <SolidColorBrush x:Key="OkSurfaceBrush" Color="#E0EED4"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#8A4B00"/>
    <SolidColorBrush x:Key="WarningSurfaceBrush" Color="#FBEBC8"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#B42318"/>
    <SolidColorBrush x:Key="DangerSurfaceBrush" Color="#FBE3E0"/>
    <SolidColorBrush x:Key="SimulatedSurfaceBrush" Color="#E6E4FA"/>
    <SolidColorBrush x:Key="SimulatedBorderBrush" Color="#5B55D6"/>
    <SolidColorBrush x:Key="SimulatedTextBrush" Color="#3A3499"/>

    <!-- Charts: the live trace is olive, marks amber, anchors cyan -->
    <SolidColorBrush x:Key="ChartBackgroundBrush" Color="#FBFAF5"/>
    <SolidColorBrush x:Key="ChartTextBrush" Color="#4A5040"/>
    <SolidColorBrush x:Key="ChartGridBrush" Color="#D8D4C4"/>
    <SolidColorBrush x:Key="ChartLineBrush" Color="#4F7A00"/>
    <SolidColorBrush x:Key="ChartMarkBrush" Color="#A35B00"/>
    <SolidColorBrush x:Key="ChartAnchorBrush" Color="#2F6F8A"/>
    <SolidColorBrush x:Key="ChartGapBrush" Color="#A9A48E" Opacity="0.35"/>
    <SolidColorBrush x:Key="ChartWarnBrush" Color="#B42318"/>
</ResourceDictionary>
