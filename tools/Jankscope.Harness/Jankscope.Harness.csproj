<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- net10.0-windows + WinForms: the window for the flip-model swap chain comes from WinForms, so the harness needs no native import of its own (no CreateWindowEx, no QueryPerformanceCounter). -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Jankscope.Harness</RootNamespace>
    <AssemblyName>jankscope-harness</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Jankscope.Harness.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Jankscope.Core\Jankscope.Core.csproj" />
    <PackageReference Include="Vortice.Direct3D11" />
    <PackageReference Include="Vortice.DXGI" />
  </ItemGroup>
</Project>
