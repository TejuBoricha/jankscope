                                        <Button x:Name="UseKeyPressButton" Content="Use Key-Press Instant" Padding="8,4" FontSize="11" Click="OnUseKeyPressClicked"/>
                                        <Button x:Name="ClearChoiceButton" Content="Clear Choice" Padding="8,4" FontSize="11" Click="OnClearChoiceClicked" Margin="0"/>
                                    </WrapPanel>

                                    <DockPanel Grid.Row="3">
                                        <TextBlock DockPanel.Dock="Left" Text="NOTE:" Style="{StaticResource Overline}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBox x:Name="NoteBox" MaxLength="2000" Height="28" VerticalContentAlignment="Center"
                                                 ToolTip="Optional note about what happened on screen (automatically redacted on export)."
                                                 LostFocus="OnNoteLostFocus" AutomationProperties.Name="Note about this mark"/>
                                    </DockPanel>
                                </Grid>
                            </Border>

                            <!-- Col 1: Evidence-Graded Root-Cause Hypotheses -->
                            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,8,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <DockPanel Grid.Row="0" Margin="0,0,0,5">
                                        <Border DockPanel.Dock="Right" Style="{StaticResource BadgeBorder}" Padding="6,2">
                                            <TextBlock Text="FACTS vs. INFERENCES" FontFamily="Consolas" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource CyanAccentBrush}"/>
                                        </Border>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="3" Height="12" CornerRadius="1.5" Background="{DynamicResource AccentBrush}" Margin="0,0,7,0"/>
                                            <TextBlock Style="{StaticResource CardTitle}" Text="04 // ROOT-CAUSE HYPOTHESIS ENGINE"/>
                                        </StackPanel>
                                    </DockPanel>

                                    <ListBox x:Name="HypothesesList" Grid.Row="1" AutomationProperties.Name="Evidence-graded hypotheses">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,2">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border Style="{StaticResource BadgeBorder}" Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentBrush}" Margin="0,0,8,0" Padding="6,1">
                                                            <TextBlock Text="{Binding GradeBadge}" FontFamily="Consolas" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource CyanAccentBrush}"/>
                                                        </Border>
                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Summary}" FontSize="11.5" Margin="0,3,0,2" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding SupportingEvidence}" Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding FalsifierText}" Foreground="{DynamicResource WarningBrush}" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Border>

                            <!-- Col 2: Incident Smoothness Gauge & Latency Tier Distribution -->
                            <Border Grid.Column="2" Style="{StaticResource Card}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,5">
                                        <Border Width="3" Height="12" CornerRadius="1.5" Background="{DynamicResource PurpleAccentBrush}" Margin="0,0,7,0"/>
                                        <TextBlock Style="{StaticResource CardTitle}" Text="05 // WINDOW PACING TIERS"/>
                                    </StackPanel>
                                    <ContentControl x:Name="InvestigatorDistributionHost" Grid.Row="1" Focusable="False"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>

            <!-- ========================================================================= -->
            <!-- WORKSPACE 03: ZERO-SCROLL SYSTEM CAPABILITY & COEXISTENCE RADAR           -->
            <!-- ========================================================================= -->
            <Grid x:Name="PageRadar" Grid.Row="1" Visibility="Collapsed" Margin="16,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource HeroCard}" Margin="0,0,0,10">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Export Redacted Compatibility Report..." Style="{StaticResource PrimaryButton}"
                                Click="OnExportCompatibilityClicked" VerticalAlignment="Center" Margin="16,0,0,0"/>
