<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Core Surfaces -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F3F6FA"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="#EAEFF6"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="PanelRaisedBrush" Color="#EDF1F7"/>
    <SolidColorBrush x:Key="PanelInsetBrush" Color="#E6EBF3"/>
    <SolidColorBrush x:Key="CardHeaderBrush" Color="#F7F9FC"/>

    <LinearGradientBrush x:Key="HeroBannerBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#E8F1FE" Offset="0.0"/>
        <GradientStop Color="#F2F6FC" Offset="0.6"/>
        <GradientStop Color="#EDE9FE" Offset="1.0"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="KpiCardBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFF" Offset="0.0"/>
        <GradientStop Color="#F8FAFD" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- Text & Borders -->
    <SolidColorBrush x:Key="ForegroundBrush" Color="#111827"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#4B5563"/>
    <SolidColorBrush x:Key="SubtleTextBrush" Color="#6B7280"/>
    <SolidColorBrush x:Key="BorderLineBrush" Color="#D1D9E6"/>
    <SolidColorBrush x:Key="BorderHighlightBrush" Color="#9FB3C8"/>

    <!-- Interactive & Brand Accents -->
    <SolidColorBrush x:Key="AccentBrush" Color="#1D5FD1"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#DBEAFE"/>
    <SolidColorBrush x:Key="AccentTextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CyanAccentBrush" Color="#0891B2"/>
    <SolidColorBrush x:Key="PurpleAccentBrush" Color="#6D28D9"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#E2E8F2"/>
    <SolidColorBrush x:Key="SelectedBrush" Color="#CFE0FB"/>

    <!-- Semantic Status & Evidence Grades -->
    <SolidColorBrush x:Key="OkBrush" Color="#047857"/>
    <SolidColorBrush x:Key="OkSurfaceBrush" Color="#D1FAE5"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#92400E"/>
    <SolidColorBrush x:Key="WarningSurfaceBrush" Color="#FEF3C7"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#B91C1C"/>
    <SolidColorBrush x:Key="DangerSurfaceBrush" Color="#FEE2E2"/>
    <SolidColorBrush x:Key="SimulatedSurfaceBrush" Color="#EDE9FE"/>
    <SolidColorBrush x:Key="SimulatedBorderBrush" Color="#7C3AED"/>
    <SolidColorBrush x:Key="SimulatedTextBrush" Color="#5B21B6"/>

    <!-- Oscilloscope & Telemetry Chart Palette -->
    <SolidColorBrush x:Key="ChartBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ChartTextBrush" Color="#4A5262"/>
    <SolidColorBrush x:Key="ChartGridBrush" Color="#D5D9E1"/>
    <SolidColorBrush x:Key="ChartLineBrush" Color="#1D5FD1"/>
    <SolidColorBrush x:Key="ChartMarkBrush" Color="#B26A00"/>
    <SolidColorBrush x:Key="ChartAnchorBrush" Color="#1E7B45"/>
    <SolidColorBrush x:Key="ChartGapBrush" Color="#9AA1B0" Opacity="0.35"/>
    <SolidColorBrush x:Key="ChartWarnBrush" Color="#C62828"/>
</ResourceDictionary>
