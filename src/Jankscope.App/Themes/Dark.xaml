<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Core Surfaces -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#0D1117"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="#111620"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#151B26"/>
    <SolidColorBrush x:Key="PanelRaisedBrush" Color="#1D2533"/>
    <SolidColorBrush x:Key="PanelInsetBrush" Color="#0B0F15"/>
    <SolidColorBrush x:Key="CardHeaderBrush" Color="#18202D"/>

    <LinearGradientBrush x:Key="HeroBannerBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#162235" Offset="0.0"/>
        <GradientStop Color="#111927" Offset="0.55"/>
        <GradientStop Color="#171E2E" Offset="1.0"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="KpiCardBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#192130" Offset="0.0"/>
        <GradientStop Color="#131924" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- Text & Borders -->
    <SolidColorBrush x:Key="ForegroundBrush" Color="#F0F4FA"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#8E9BAE"/>
    <SolidColorBrush x:Key="SubtleTextBrush" Color="#637083"/>
    <SolidColorBrush x:Key="BorderLineBrush" Color="#263142"/>
    <SolidColorBrush x:Key="BorderHighlightBrush" Color="#374863"/>

    <!-- Interactive & Brand Accents -->
    <SolidColorBrush x:Key="AccentBrush" Color="#3898FF"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#1A3252"/>
    <SolidColorBrush x:Key="AccentTextBrush" Color="#06101E"/>
    <SolidColorBrush x:Key="CyanAccentBrush" Color="#22D3EE"/>
    <SolidColorBrush x:Key="PurpleAccentBrush" Color="#A78BFA"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#242E40"/>
    <SolidColorBrush x:Key="SelectedBrush" Color="#1C3A63"/>

    <!-- Semantic Status & Evidence Grades -->
    <SolidColorBrush x:Key="OkBrush" Color="#34D399"/>
    <SolidColorBrush x:Key="OkSurfaceBrush" Color="#112E28"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#FBBF24"/>
    <SolidColorBrush x:Key="WarningSurfaceBrush" Color="#312713"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#F87171"/>
    <SolidColorBrush x:Key="DangerSurfaceBrush" Color="#35181C"/>
    <SolidColorBrush x:Key="SimulatedSurfaceBrush" Color="#261B3D"/>
    <SolidColorBrush x:Key="SimulatedBorderBrush" Color="#7C3AED"/>
    <SolidColorBrush x:Key="SimulatedTextBrush" Color="#C4B5FD"/>

    <!-- Oscilloscope & Telemetry Chart Palette -->
    <SolidColorBrush x:Key="ChartBackgroundBrush" Color="#090D13"/>
    <SolidColorBrush x:Key="ChartTextBrush" Color="#9BA8BC"/>
    <SolidColorBrush x:Key="ChartGridBrush" Color="#1E2837"/>
    <SolidColorBrush x:Key="ChartLineBrush" Color="#5AA9FF"/>
    <SolidColorBrush x:Key="ChartMarkBrush" Color="#FBBF24"/>
    <SolidColorBrush x:Key="ChartAnchorBrush" Color="#34D399"/>
    <SolidColorBrush x:Key="ChartGapBrush" Color="#2A3342" Opacity="0.55"/>
    <SolidColorBrush x:Key="ChartWarnBrush" Color="#FF6B60"/>
</ResourceDictionary>
