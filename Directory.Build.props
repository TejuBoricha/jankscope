<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- NuGet vulnerability-audit warnings (NU1900 = audit data unreachable, offline or feed outage; NU1901-NU1904 = known vulnerabilities) depend on the live advisory feed. They must stay visible, but they
         must not break a restore or build that worked yesterday; dependency review is a separate, conscious step. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1900;NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <!-- AllowUnsafeBlocks is deliberately NOT set here: only the assembly that owns native interop (Jankscope.Platform) enables it. -->
    <Version>0.1.0</Version>
    <Product>Jankscope</Product>
    <Authors>Jankscope contributors</Authors>
    <Copyright>Copyright (c) 2026 Jankscope contributors</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- Spec §6.6: .NET 8 and 9 reach end of support on 2026-11-10; no project may target them. -->
  <Target Name="JankscopeForbidOldTargetFrameworks" BeforeTargets="CoreCompile"
          Condition="$(TargetFramework.StartsWith('net8')) Or $(TargetFramework.StartsWith('net9'))">
    <Error Text="Jankscope forbids targeting .NET 8/9 (end of support 2026-11-10). Use net10.0 or net10.0-windows." />
  </Target>
</Project>
