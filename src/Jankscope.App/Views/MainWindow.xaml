                            <TextBlock Style="{StaticResource Heading}" Text="System Readiness &amp; Capability Radar"/>
                            <TextBlock Style="{StaticResource Muted}" FontSize="12"
                                       Text="Probes 41 read-only hardware, display, OS security, anti-cheat coexistence, and ETW telemetry rows at startup. Every row explains what was detected, its provenance, and its impact on frame pacing."/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,10">
                    <Border Style="{StaticResource KpiCard}" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Overline}" Text="CAPABILITY ROWS PROBED"/>
                            <TextBlock x:Name="RadarTotalCount" Style="{StaticResource KpiValue}" Text="--" Margin="0,3,0,1"/>
                            <TextBlock Style="{StaticResource Muted}" FontFamily="Consolas" FontSize="10.5" Text="14 read-only system probes"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource KpiCard}" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Overline}" Text="AVAILABLE &amp; READY"/>
                            <TextBlock x:Name="RadarReadyCount" Style="{StaticResource KpiValue}" Foreground="{DynamicResource OkBrush}" Text="--" Margin="0,3,0,1"/>
                            <TextBlock Style="{StaticResource Muted}" FontFamily="Consolas" FontSize="10.5" Text="Full telemetry coverage"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource KpiCard}" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Overline}" Text="NEEDS SETUP / PERMISSION"/>
                            <TextBlock x:Name="RadarAttentionCount" Style="{StaticResource KpiValue}" Foreground="{DynamicResource WarningBrush}" Text="--" Margin="0,3,0,1"/>
                            <TextBlock Style="{StaticResource Muted}" FontFamily="Consolas" FontSize="10.5" Text="Optional group or elevation"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource KpiCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Overline}" Text="ANTI-CHEAT POSTURE"/>
                            <TextBlock x:Name="RadarAntiCheatStatus" Style="{StaticResource KpiValue}" FontSize="19" Text="Checking..." Margin="0,3,0,1"/>
                            <TextBlock Style="{StaticResource Muted}" FontFamily="Consolas" FontSize="10.5" Text="HC-1 passive coexistence"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Border Grid.Row="2" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="0,0,0,8">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="FILTER:" Style="{StaticResource Overline}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <RadioButton x:Name="RadarFilterAll" Style="{StaticResource PillRadio}" GroupName="RadarFilter" Content="All Rows" IsChecked="True" Checked="OnRadarFilterChanged"/>
                                <RadioButton x:Name="RadarFilterReady" Style="{StaticResource PillRadio}" GroupName="RadarFilter" Content="Ready" Checked="OnRadarFilterChanged"/>
                                <RadioButton x:Name="RadarFilterAttention" Style="{StaticResource PillRadio}" GroupName="RadarFilter" Content="Action / Unavailable" Checked="OnRadarFilterChanged" Margin="0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="3" Height="12" CornerRadius="1.5" Background="{DynamicResource CyanAccentBrush}" Margin="0,0,7,0"/>
                                <TextBlock Style="{StaticResource CardTitle}" Text="HARDWARE, DISPLAY, SECURITY &amp; TELEMETRY CAPABILITY MATRIX"/>
                            </StackPanel>
                        </DockPanel>

                        <ListBox x:Name="RadarList" Grid.Row="1" AutomationProperties.Name="System capability matrix rows">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="230"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="130"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Top">
                                            <Border Style="{StaticResource BadgeBorder}" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding Domain}" FontFamily="Consolas" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource CyanAccentBrush}"/>
                                            </Border>
                                            <TextBlock Text="{Binding Id}" Style="{StaticResource Muted}" FontFamily="Consolas" FontSize="10.5" Margin="2,3,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="8,0">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding SourceInfo}" Style="{StaticResource Muted}" FontFamily="Consolas" FontSize="10" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Top" Margin="8,0">
                                            <TextBlock Text="{Binding ValueOrReason}" FontFamily="Consolas" FontSize="11.5" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding PlainEnglishImpact}" Style="{StaticResource Muted}" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <Border Grid.Column="3" Style="{StaticResource BadgeBorder}" HorizontalAlignment="Right" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding StatusBadge}" FontFamily="Consolas" FontSize="10.5" FontWeight="Bold"/>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>

            <!-- ========================================================================= -->
            <!-- WORKSPACE 04: ZERO-SCROLL INPUT & MOUSE POLLING CONTINUITY LAB            -->
            <!-- ========================================================================= -->
            <Grid x:Name="PageLab" Grid.Row="1" Visibility="Collapsed" Margin="16,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource HeroCard}" Margin="0,0,0,10">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                            <Button Content="Load Simulated Stall Trace" Style="{StaticResource SimButton}" Click="OnLabSimulateClicked"/>
                            <Button Content="Reset Lab Buffer" Click="OnLabResetClicked" Margin="0"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Style="{StaticResource Heading}" Text="Input Continuity &amp; Mouse Polling Lab"/>
                            <TextBlock Style="{StaticResource Muted}" FontSize="12"
                                       Text="Distinguishes GPU/CPU frame hitches from wireless 2.4 GHz polling drops, USB hub contention, and message-pump stalls. Orbit your cursor inside the vector reticle below to measure pointer delivery intervals in real time (100% HC-4 compliant)."/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,10">
                    <Border Style="{StaticResource KpiCard}" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Overline}" Text="EFFECTIVE EVENT RATE"/>
                            <TextBlock x:Name="LabHzValue" Style="{StaticResource KpiValue}" Text="-- Hz" Margin="0,3,0,1"/>
                            <TextBlock Style="{StaticResource Muted}" FontFamily="Consolas" FontSize="10.5" Text="Derived from median dt"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource KpiCard}" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Overline}" Text="MEDIAN INTERVAL (DT)"/>
                            <TextBlock x:Name="LabMedianDt" Style="{StaticResource KpiValue}" Text="-- ms" Margin="0,3,0,1"/>
                            <TextBlock Style="{StaticResource Muted}" FontFamily="Consolas" FontSize="10.5" Text="Pointer update spacing"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource KpiCard}" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Overline}" Text="DELIVERY JITTER (P95-P50)"/>
                            <TextBlock x:Name="LabJitterMs" Style="{StaticResource KpiValue}" Text="-- ms" Margin="0,3,0,1"/>
                            <TextBlock Style="{StaticResource Muted}" FontFamily="Consolas" FontSize="10.5" Text="Lower = smoother turn"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource KpiCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Overline}" Text="MID-MOTION STALLS"/>
                            <TextBlock x:Name="LabStallCount" Style="{StaticResource KpiValue}" Text="0" Margin="0,3,0,1"/>
                            <TextBlock x:Name="LabVerdictText" Style="{StaticResource Muted}" FontFamily="Consolas" FontSize="10.5" TextTrimming="CharacterEllipsis" Text="Move cursor in reticle"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                            <Border Width="3" Height="12" CornerRadius="1.5" Background="{DynamicResource CyanAccentBrush}" Margin="0,0,7,0"/>
                            <TextBlock Style="{StaticResource CardTitle}" Text="LIVE POINTER VECTOR RETICLE &amp; INTER-EVENT ARRIVAL SPECTRUM"/>
                        </StackPanel>
                        <ContentControl x:Name="InputPollingHost" Grid.Row="1" Focusable="False"/>
                    </Grid>
                </Border>

                <UniformGrid Grid.Row="3" Columns="3">
                    <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Overline}" Foreground="{DynamicResource CyanAccentBrush}" Text="SIGNATURE A // RENDER STALL"/>
                            <TextBlock Style="{StaticResource CardTitle}" Margin="0,3,0,3" Text="Pure Frame-Pacing Hitch"/>
                            <TextBlock Style="{StaticResource Muted}" FontSize="11.5"
                                       Text="Frame time spikes (> 33 ms) on the Capture Scope while mouse arrival intervals stay steady. Caused by shader compilation, asset traversal, or GPU/CPU submission stalls."/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Overline}" Foreground="{DynamicResource WarningBrush}" Text="SIGNATURE B // INPUT STALL"/>
                            <TextBlock Style="{StaticResource CardTitle}" Margin="0,3,0,3" Text="Pure Pointer / Polling Drop"/>
                            <TextBlock Style="{StaticResource Muted}" FontSize="11.5"
                                       Text="Frame times remain flat (8.3 ms at 120 FPS), but pointer intervals jump above 35 ms mid-swipe. Caused by 2.4 GHz wireless interference or USB hub contention."/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Overline}" Foreground="{DynamicResource DangerBrush}" Text="SIGNATURE C // SYSTEM FREEZE"/>
                            <TextBlock Style="{StaticResource CardTitle}" Margin="0,3,0,3" Text="Coupled Kernel / DPC Stall"/>
                            <TextBlock Style="{StaticResource Muted}" FontSize="11.5"
                                       Text="Both frame delivery and pointer arrival stall at the exact same timestamp. Typically caused by kernel DPC/ISR latency spikes or OS-wide thermal throttling."/>
                        </StackPanel>
                    </Border>
                </UniformGrid>
            </Grid>

            <!-- ========================================================================= -->
            <!-- WORKSPACE 05: STUDIO CONFIGURATION & AUDIO CUES                           -->
            <!-- ========================================================================= -->
            <Grid x:Name="PageSettings" Grid.Row="1" Visibility="Collapsed" Margin="16,12">
                <StackPanel>
                    <Border Style="{StaticResource HeroCard}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Heading}" Text="Studio Configuration &amp; Capture Ring"/>
                            <TextBlock Style="{StaticResource Muted}" Text="Configure global mark hotkeys, rolling pre-roll/post-roll memory window lengths, audible confirmation tones, and visual theme."/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="01 // GLOBAL MARK HOTKEYS (HC-4 REGISTERHOTKEY)"/>
                            <TextBlock Style="{StaticResource Muted}" FontSize="11.5" Margin="0,3,0,10"
                                       Text="Each hotkey requires at least one modifier (Ctrl, Alt, or Shift) plus a key (for example Ctrl+Alt+F9). Windows notifies Jankscope only when that exact chord is pressed."/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="190"/>
                                    <ColumnDefinition Width="240"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Mark Stutter Chord" VerticalAlignment="Center" Margin="0,0,0,8"/>
                                <TextBox x:Name="StutterChordBox" Grid.Row="0" Grid.Column="1" Margin="0,0,12,8" AutomationProperties.Name="Mark stutter hotkey"/>
                                <TextBlock x:Name="StutterChordStatus" Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" Margin="0,0,0,8" TextWrapping="Wrap"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Mark Input Freeze Chord" VerticalAlignment="Center"/>
                                <TextBox x:Name="InputChordBox" Grid.Row="1" Grid.Column="1" Margin="0,0,12,0" AutomationProperties.Name="Mark input stall hotkey"/>
                                <TextBlock x:Name="InputChordStatus" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="02 // ROLLING MEMORY RING &amp; AUDIBLE CUES"/>
