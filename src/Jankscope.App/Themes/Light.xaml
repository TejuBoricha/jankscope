<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Core Surfaces -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="PanelRaisedBrush" Color="#EEF2F6"/>
    <SolidColorBrush x:Key="PanelInsetBrush" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="CardHeaderBrush" Color="#F8FAFC"/>

    <LinearGradientBrush x:Key="HeroBannerBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#E0F2FE" Offset="0.0"/>
        <GradientStop Color="#F1F5F9" Offset="0.6"/>
        <GradientStop Color="#EDE9FE" Offset="1.0"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="KpiCardBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFF" Offset="0.0"/>
        <GradientStop Color="#F8FAFC" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- Text & Borders -->
    <SolidColorBrush x:Key="ForegroundBrush" Color="#0F172A"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#475569"/>
    <SolidColorBrush x:Key="SubtleTextBrush" Color="#64748B"/>
    <SolidColorBrush x:Key="BorderLineBrush" Color="#CBD5E1"/>
    <SolidColorBrush x:Key="BorderHighlightBrush" Color="#94A3B8"/>

    <!-- Interactive & Brand Accents -->
    <SolidColorBrush x:Key="AccentBrush" Color="#0284C7"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#E0F2FE"/>
    <SolidColorBrush x:Key="AccentTextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CyanAccentBrush" Color="#0891B2"/>
    <SolidColorBrush x:Key="PurpleAccentBrush" Color="#6D28D9"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="SelectedBrush" Color="#BAE6FD"/>

    <!-- Semantic Status & Evidence Grades -->
    <SolidColorBrush x:Key="OkBrush" Color="#047857"/>
    <SolidColorBrush x:Key="OkSurfaceBrush" Color="#D1FAE5"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#B45309"/>
    <SolidColorBrush x:Key="WarningSurfaceBrush" Color="#FEF3C7"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#BE123C"/>
    <SolidColorBrush x:Key="DangerSurfaceBrush" Color="#FFE4E6"/>
    <SolidColorBrush x:Key="SimulatedSurfaceBrush" Color="#EDE9FE"/>
    <SolidColorBrush x:Key="SimulatedBorderBrush" Color="#7C3AED"/>
    <SolidColorBrush x:Key="SimulatedTextBrush" Color="#5B21B6"/>

    <!-- Oscilloscope & Telemetry Chart Palette -->
    <SolidColorBrush x:Key="ChartBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ChartTextBrush" Color="#334155"/>
    <SolidColorBrush x:Key="ChartGridBrush" Color="#CBD5E1"/>
    <SolidColorBrush x:Key="ChartLineBrush" Color="#0284C7"/>
    <SolidColorBrush x:Key="ChartMarkBrush" Color="#B45309"/>
    <SolidColorBrush x:Key="ChartAnchorBrush" Color="#047857"/>
    <SolidColorBrush x:Key="ChartGapBrush" Color="#94A3B8" Opacity="0.35"/>
    <SolidColorBrush x:Key="ChartWarnBrush" Color="#BE123C"/>
</ResourceDictionary>
