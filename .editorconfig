root = true

[*]
charset = utf-8
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{json,csproj,props,slnx,yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# Windows PowerShell 5.1 reads BOM-less files as the ANSI code page and corrupts non-ASCII text. Scripts are ASCII or UTF-8 with BOM
# (RepoLintTests enforces it).
[*.ps1]
charset = utf-8-bom
